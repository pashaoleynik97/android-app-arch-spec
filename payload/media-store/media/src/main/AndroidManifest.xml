<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Runs the stale-media sweep at process start (MediaStartupInitializer) without the host's App class
             knowing this module. tools:node="merge" adds the entry to androidx.startup's single provider. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="{{ROOT_PACKAGE}}.media.MediaStartupInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
