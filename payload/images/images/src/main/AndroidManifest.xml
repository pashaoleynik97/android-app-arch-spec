<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Registers the authenticated ImageLoader as Coil's singleton at process start (ImageLoaderInitializer),
             without the host's App class knowing this module. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="{{ROOT_PACKAGE}}.images.ImageLoaderInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
