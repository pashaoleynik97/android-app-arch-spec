# Copy this file to `keystore.properties` (gitignored) and fill in the real values to sign local builds.
# With these values present BOTH debug and release are signed with the same key, so builds launched from
# Android Studio match CI artifacts. Without them, release builds fall back to the debug key.
#
# CI does not use this file: it passes the same four values as environment variables
# (KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD).
#
# Optional: point `storeFile` at a keystore elsewhere (relative to the project root).
# If omitted, the build looks for `{{KEYSTORE_FILE}}` at the project root (gitignored).
# storeFile={{KEYSTORE_FILE}}
keystorePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password
