# --- files that are deliberately absent from a fresh clone ---
keystore.properties
local.properties

# --- build tooling (Gradle / AGP API types named in the build references) ---
CommonExtension
ApplicationExtension
LibraryExtension
VersionCatalog
Project

# --- names that look like paths but are not repository files ---
# GitHub Actions ids (owner/action) used in CI references
^(actions|gradle/actions|github|softprops|android-actions)/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)?(@.*)?$
# git branch names and patterns
^(release|feature|hotfix|bugfix)/
# files written at run time into the gitignored evidence folder (device verification)
^evidence/

# --- Android framework / AndroidX / Coil types named by Recommended-component references ---
PackageManager
WhileSubscribed
AsyncImage
SingletonImageLoader
SingletonImageLoader.Factory
ImageLoader
ImageLoader.Builder
InitializationProvider
