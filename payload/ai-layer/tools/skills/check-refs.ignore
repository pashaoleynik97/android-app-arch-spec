# Tokens check-refs.sh accepts without finding them in the repository.
# One token per line, or an anchored regex starting with ^. Blank lines and # comments are ignored.
# Add project names here only when they are genuinely external (a library type, a vocabulary word);
# a moved file or a renamed class is fixed in the skill, not silenced here.

# --- generic feature placeholders used in skills (`x` / `y` stand for any feature) ---
^:[xy](-ui(-api)?)?(:[A-Za-z]+)?$
^[XY][A-Z][A-Za-z0-9]*(\.kt)?$
^Fake[XY][A-Z]?[A-Za-z0-9]*$
^Recording[XY]?[A-Z]?[A-Za-z0-9]*$

